<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Rastrear.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Rastrear">

    <Grid Background="{ThemeResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera: marca, lema y metadatos del video -->
        <Grid Grid.Row="0" Padding="24,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <Canvas Width="32" Height="32" VerticalAlignment="Center">
                    <Path Data="M4 24 C 10 22, 11 16, 16 16 S 22 10, 28 6" Stroke="{ThemeResource AccentTextBrush}" StrokeThickness="2" Opacity="0.55" />
                    <Ellipse Canvas.Left="8" Canvas.Top="8" Width="16" Height="16" Stroke="{ThemeResource AccentTextBrush}" StrokeThickness="2.5" />
                    <Path Data="M16 4V8 M16 24V28 M4 16H8 M24 16H28" Stroke="{ThemeResource AccentTextBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Ellipse Canvas.Left="13.5" Canvas.Top="13.5" Width="5" Height="5" Fill="{ThemeResource AccentTextBrush}" />
                </Canvas>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Rastrear" FontFamily="{StaticResource TitleFont}" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                    <TextBlock Text="Sigue lo que importa" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="VideoMetaText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{ThemeResource TextMutedBrush}" Text="Ningún video cargado" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <HyperlinkButton Content="Acerca de" Padding="4,2" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" Click="OnAcercaDeClick" />
                <Button x:Name="BtnElegirVideo" Content="Elegir video…" Click="OnElegirVideoClick" />
            </StackPanel>
        </Grid>

        <!-- Acerca de: nombre, versión, licencia y el crédito a Rodaje que exige su licencia (término 1 de la sección 7) -->
        <ContentDialog x:Name="AboutDialog" CloseButtonText="Cerrar" DefaultButton="Close">
            <StackPanel Spacing="8" MaxWidth="420">
                <TextBlock Text="Rastrear" FontFamily="{StaticResource TitleFont}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="AboutVersionText" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{ThemeResource TextMutedBrush}" />
                <TextBlock Text="Copyright (C) 2026 Dathinel. Software libre bajo la licencia GPLv3 (GPL-3.0-only); el texto completo va en LICENSE junto al programa." TextWrapping="Wrap" />
                <HyperlinkButton NavigateUri="https://github.com/Dathinel/rodaje" Padding="0,2">
                    <TextBlock Text="Basado en el editor de video de código abierto de Dathinel / Rodaje (https://github.com/Dathinel/rodaje)" TextWrapping="Wrap" />
                </HyperlinkButton>
            </StackPanel>
        </ContentDialog>

        <!-- Barra de avisos / errores -->
        <InfoBar x:Name="NotificationBar" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="24,0,24,8" />

        <!-- Área principal -->
        <Grid Grid.Row="2" Margin="24,0,24,24" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="360" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Panel izquierdo: Reproductor y Visor -->
            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Visor de video con superposición: oscuro en los dos temas -->
                <Border Grid.Row="0" Background="{StaticResource ViewportBrush}" BorderBrush="{StaticResource ViewportBorderBrush}" BorderThickness="1" CornerRadius="8"
                        AllowDrop="True" DragOver="OnVideoDragOver" Drop="OnVideoDrop">
                    <Grid x:Name="ViewportContainer" SizeChanged="OnViewportSizeChanged">
                        <!-- Estado vacío: mira con trayectoria y qué hacer -->
                        <StackPanel x:Name="EmptyStatePrompt" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                            <Canvas Width="120" Height="120" HorizontalAlignment="Center">
                                <Path Data="M10 96 C 36 88, 42 64, 60 60 S 86 34, 110 18" Stroke="{StaticResource ReticleBrush}" StrokeThickness="3" StrokeDashArray="1,3" StrokeDashCap="Round" />
                                <Ellipse Canvas.Left="104" Canvas.Top="12" Width="12" Height="12" Fill="{StaticResource ReticleBrush}" />
                                <Ellipse Canvas.Left="32" Canvas.Top="32" Width="56" Height="56" Stroke="{StaticResource AccentTextBrush}" StrokeThickness="3" />
                                <Path Data="M60 20V34 M60 86V100 M20 60H34 M86 60H100" Stroke="{StaticResource AccentTextBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Ellipse Canvas.Left="55" Canvas.Top="55" Width="10" Height="10" Fill="{StaticResource AccentTextBrush}" />
                            </Canvas>
                            <TextBlock Text="Suelta un video aquí o pulsa «Elegir video…»" FontFamily="{StaticResource TitleFont}" FontSize="18"
                                       Foreground="{StaticResource ViewportTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Después haz clic sobre lo que quieras seguir." FontSize="13" Foreground="{StaticResource ViewportMutedBrush}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Imagen del cuadro de video -->
                        <Image x:Name="VideoDisplay" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <!-- Lienzo de superposición transparente encima de la imagen -->
                        <Canvas x:Name="OverlayCanvas" Background="Transparent"
                                PointerPressed="OnOverlayPointerPressed"
                                PointerMoved="OnOverlayPointerMoved"
                                PointerReleased="OnOverlayPointerReleased" />
                    </Grid>
                </Border>

                <!-- Controles del reproductor -->
                <Border Grid.Row="1" Background="{ThemeResource PanelBrush}" BorderBrush="{ThemeResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8"
                        Padding="16,8" Shadow="{StaticResource PanelShadow}" Translation="0,0,8">
                    <Grid RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Slider x:Name="TimeSlider" Grid.Row="0" Minimum="0" Maximum="100" Value="0" ValueChanged="OnTimeSliderValueChanged" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="BtnStepBack" Content="⏮" Click="OnStepBackClick" ToolTipService.ToolTip="Cuadro anterior" />
                                <Button x:Name="BtnPlayPause" Content="▶" Width="48" Click="OnPlayPauseClick" ToolTipService.ToolTip="Reproducir / Pausar" />
                                <Button x:Name="BtnStepForward" Content="⏭" Click="OnStepForwardClick" ToolTipService.ToolTip="Cuadro siguiente" />
                            </StackPanel>

                            <TextBlock x:Name="TimeText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{ThemeResource TextMutedBrush}" Text="00:00.00 / 00:00.00 (cuadro 0/0)" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Panel derecho: Tareas y Opciones -->
            <Border Grid.Column="1" Background="{ThemeResource PanelBrush}" BorderBrush="{ThemeResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="16" Shadow="{StaticResource PanelShadow}" Translation="0,0,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Operación" FontFamily="{StaticResource TitleFont}" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />

                        <ComboBox x:Name="TaskSelector" SelectionChanged="OnTaskSelectionChanged" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Seguir (Punto o región)" IsSelected="True" />
                            <ComboBoxItem Content="Quitar fondo (Alfa o máscara)" />
                            <ComboBoxItem Content="Detectar (Rostros o personas)" />
                            <ComboBoxItem Content="Reencuadrar (Formato vertical o cuadrado)" />
                            <ComboBoxItem Content="Estabilizar (Movimiento de cámara)" />
                        </ComboBox>

                        <StackPanel x:Name="PanelSeguir" Spacing="8">
                            <TextBlock Text="Modo de objetivo" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <RadioButton x:Name="RbSeguirPunto" Content="Punto" IsChecked="True" Checked="OnSeguirModeChanged" />
                                <RadioButton x:Name="RbSeguirRegion" Content="Región" Checked="OnSeguirModeChanged" />
                            </StackPanel>
                            <TextBlock Text="Haz clic o arrastra sobre el video para definir el objetivo." FontSize="12" Foreground="{ThemeResource TextMutedBrush}" TextWrapping="Wrap" />
                            <Border Background="{ThemeResource InsetBrush}" Padding="12,8" CornerRadius="4">
                                <TextBlock x:Name="SeguirTargetLabel" Text="Objetivo: Sin seleccionar" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{ThemeResource AccentTextBrush}" />
                            </Border>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Tamaño del patrón: 41 px" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" />
                                <Slider x:Name="SliderPatternSize" Minimum="21" Maximum="81" StepFrequency="4" Value="41" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="PanelQuitarFondo" Spacing="8" Visibility="Collapsed">
                            <ToggleSwitch x:Name="SwitchFondoModo" Header="Modo de salida"
                                          OffContent="Video con alfa (WebM/ProRes)" OnContent="Máscara en grises (MP4)" />
                            <ComboBox x:Name="ComboCalidadFondo" Header="Calidad" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Normal (MODNet)" IsSelected="True" />
                                <ComboBoxItem Content="Alta (BiRefNet lite)" />
                            </ComboBox>
                            <ComboBox x:Name="ComboDeviceFondo" Header="Dispositivo" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Automático" IsSelected="True" />
                                <ComboBoxItem Content="GPU (DirectML)" />
                                <ComboBoxItem Content="CPU" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel x:Name="PanelDetectar" Spacing="8" Visibility="Collapsed">
                            <ComboBox x:Name="ComboTargetDetectar" Header="Detectar" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Rostros" IsSelected="True" />
                                <ComboBoxItem Content="Personas" />
                            </ComboBox>
                            <ComboBox x:Name="ComboDeviceDetectar" Header="Dispositivo" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Automático" IsSelected="True" />
                                <ComboBoxItem Content="GPU (DirectML)" />
                                <ComboBoxItem Content="CPU" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel x:Name="PanelReencuadrar" Spacing="8" Visibility="Collapsed">
                            <TextBlock Text="Relación de aspecto objetivo" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <RadioButton x:Name="RbAspect916" Content="9:16" IsChecked="True" Checked="OnAspectChanged" />
                                <RadioButton x:Name="RbAspect11" Content="1:1" Checked="OnAspectChanged" />
                                <RadioButton x:Name="RbAspect45" Content="4:5" Checked="OnAspectChanged" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Suavizado de cámara" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" />
                                <Slider x:Name="SliderSmoothing" Minimum="0.1" Maximum="0.9" StepFrequency="0.05" Value="0.5" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="PanelEstabilizar" Spacing="8" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Intensidad de estabilización" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" />
                                <Slider x:Name="SliderIntensity" Minimum="0.1" Maximum="1.0" StepFrequency="0.05" Value="0.5" />
                            </StackPanel>
                            <CheckBox x:Name="ChkAutoCrop" Content="Recorte automático" IsChecked="True" />
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource PanelBorderBrush}" />

                        <!-- Acciones y progreso -->
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnEjecutar" Content="Ejecutar" Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch" Click="OnEjecutarClick" />
                                <Button x:Name="BtnCancelar" Grid.Column="1" Content="Cancelar" IsEnabled="False" Click="OnCancelarClick" />
                            </Grid>

                            <ProgressBar x:Name="TaskProgressBar" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Tic de «hecho»: aparece con un fundido y un pequeño rebote -->
                                <Grid x:Name="DoneMark" Width="24" Height="24" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="DoneScale" ScaleX="0.5" ScaleY="0.5" />
                                    </Grid.RenderTransform>
                                    <Grid.Resources>
                                        <Storyboard x:Name="DoneStoryboard">
                                            <DoubleAnimation Storyboard.TargetName="DoneMark" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                                            <DoubleAnimation Storyboard.TargetName="DoneScale" Storyboard.TargetProperty="ScaleX" From="0.5" To="1" Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="DoneScale" Storyboard.TargetProperty="ScaleY" From="0.5" To="1" Duration="0:0:0.45">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </Grid.Resources>
                                    <Ellipse Fill="{ThemeResource AccentTextBrush}" />
                                    <Path Data="M7 12.5 L10.5 16 L17 9" Stroke="{ThemeResource PanelBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Grid>
                                <TextBlock x:Name="TaskProgressText" Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                                <TextBlock x:Name="TaskTimeText" Grid.Column="2" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{ThemeResource TextMutedBrush}" Visibility="Collapsed" />
                            </Grid>
                        </StackPanel>

                        <Button x:Name="BtnExportar" Content="Exportar resultado…" HorizontalAlignment="Stretch" IsEnabled="False" Click="OnExportarClick" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
