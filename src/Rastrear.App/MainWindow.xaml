<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Rastrear.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shapes="using:Microsoft.UI.Xaml.Shapes"
    Title="Rastrear">

    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#2C2C2C" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="Rastrear" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" />
                    <TextBlock Text="· Seguimiento y visión con IA" FontSize="13" Foreground="#9E9E9E" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="VideoMetaText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="13" Foreground="#B0B0B0" Text="Ningún video cargado" />

                <Button x:Name="BtnElegirVideo" Grid.Column="2" Content="Elegir video…" Click="OnElegirVideoClick" />
            </Grid>
        </Border>

        <!-- Barra de avisos / errores -->
        <InfoBar x:Name="NotificationBar" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="0" CornerRadius="0" />

        <!-- Área principal -->
        <Grid Grid.Row="2" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="360" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Panel izquierdo: Reproductor y Visor -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Visor de video con superposición -->
                <Border Grid.Row="0" Background="#0A0A0A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6"
                        AllowDrop="True" DragOver="OnVideoDragOver" Drop="OnVideoDrop">
                    <Grid x:Name="ViewportContainer" SizeChanged="OnViewportSizeChanged">
                        <!-- Mensaje de soltar video cuando está vacío -->
                        <StackPanel x:Name="EmptyStatePrompt" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <TextBlock Text="🎬" FontSize="48" HorizontalAlignment="Center" />
                            <TextBlock Text="Arrastra y suelta un video aquí o pulsa «Elegir video…»"
                                       FontSize="14" Foreground="#888888" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Imagen del cuadro de video -->
                        <Image x:Name="VideoDisplay" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <!-- Lienzo de superposición transparente encima de la imagen -->
                        <Canvas x:Name="OverlayCanvas" Background="Transparent"
                                PointerPressed="OnOverlayPointerPressed"
                                PointerMoved="OnOverlayPointerMoved"
                                PointerReleased="OnOverlayPointerReleased" />
                    </Grid>
                </Border>

                <!-- Controles del reproductor -->
                <Border Grid.Row="1" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6"
                        Margin="0,8,0,0" Padding="12,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Barra de deslizamiento de tiempo -->
                        <Slider x:Name="TimeSlider" Grid.Row="0" Minimum="0" Maximum="100" Value="0"
                                ValueChanged="OnTimeSliderValueChanged" Margin="0,0,0,4" />

                        <!-- Botones de control y texto de tiempo -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button x:Name="BtnStepBack" Content="⏮" Click="OnStepBackClick" ToolTipService.ToolTip="Cuadro anterior" />
                                <Button x:Name="BtnPlayPause" Content="▶" Width="44" Click="OnPlayPauseClick" ToolTipService.ToolTip="Reproducir / Pausar" />
                                <Button x:Name="BtnStepForward" Content="⏭" Click="OnStepForwardClick" ToolTipService.ToolTip="Cuadro siguiente" />
                            </StackPanel>

                            <TextBlock x:Name="TimeText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="13" Foreground="#B0B0B0" Text="00:00.00 / 00:00.00 (cuadro 0/0)" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Panel derecho: Tareas y Opciones -->
            <Border Grid.Column="2" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="1" CornerRadius="6" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Operación" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" />

                        <!-- Selector de tarea -->
                        <ComboBox x:Name="TaskSelector" SelectionChanged="OnTaskSelectionChanged" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Seguir (Punto o región)" IsSelected="True" />
                            <ComboBoxItem Content="Quitar fondo (Alfa o máscara)" />
                            <ComboBoxItem Content="Detectar (Rostros o personas)" />
                            <ComboBoxItem Content="Reencuadrar (Formato vertical o cuadrado)" />
                            <ComboBoxItem Content="Estabilizar (Movimiento de cámara)" />
                        </ComboBox>

                        <!-- Contenedor dinámico de opciones por tarea -->
                        <StackPanel x:Name="PanelSeguir" Spacing="12">
                            <TextBlock Text="Modo de objetivo" FontSize="13" FontWeight="SemiBold" Foreground="#CCCCCC" />
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <RadioButton x:Name="RbSeguirPunto" Content="Punto" IsChecked="True" Checked="OnSeguirModeChanged" />
                                <RadioButton x:Name="RbSeguirRegion" Content="Región" Checked="OnSeguirModeChanged" />
                            </StackPanel>
                            <TextBlock Text="Haz clic o arrastra sobre el video para definir el objetivo."
                                       FontSize="12" Foreground="#888888" TextWrapping="Wrap" />
                            <Border Background="#242424" Padding="10,8" CornerRadius="4">
                                <TextBlock x:Name="SeguirTargetLabel" Text="Objetivo: Sin seleccionar" FontSize="12" Foreground="#00E5FF" />
                            </Border>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Tamaño del patrón: 41 px" FontSize="12" Foreground="#AAAAAA" />
                                <Slider x:Name="SliderPatternSize" Minimum="21" Maximum="81" StepFrequency="4" Value="41" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="PanelQuitarFondo" Spacing="12" Visibility="Collapsed">
                            <ToggleSwitch x:Name="SwitchFondoModo" Header="Modo de salida"
                                          OffContent="Video con alfa (WebM/ProRes)" OnContent="Máscara en grises (MP4)" />
                            <ComboBox x:Name="ComboCalidadFondo" Header="Calidad" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Normal (MODNet)" IsSelected="True" />
                                <ComboBoxItem Content="Alta (BiRefNet lite)" />
                            </ComboBox>
                            <ComboBox x:Name="ComboDeviceFondo" Header="Dispositivo" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Automático" IsSelected="True" />
                                <ComboBoxItem Content="GPU (DirectML)" />
                                <ComboBoxItem Content="CPU" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel x:Name="PanelDetectar" Spacing="12" Visibility="Collapsed">
                            <ComboBox x:Name="ComboTargetDetectar" Header="Detectar" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Rostros" IsSelected="True" />
                                <ComboBoxItem Content="Personas" />
                            </ComboBox>
                            <ComboBox x:Name="ComboDeviceDetectar" Header="Dispositivo" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Automático" IsSelected="True" />
                                <ComboBoxItem Content="GPU (DirectML)" />
                                <ComboBoxItem Content="CPU" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel x:Name="PanelReencuadrar" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Relación de aspecto objetivo" FontSize="13" FontWeight="SemiBold" Foreground="#CCCCCC" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <RadioButton x:Name="RbAspect916" Content="9:16" IsChecked="True" Checked="OnAspectChanged" />
                                <RadioButton x:Name="RbAspect11" Content="1:1" Checked="OnAspectChanged" />
                                <RadioButton x:Name="RbAspect45" Content="4:5" Checked="OnAspectChanged" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Suavizado de cámara" FontSize="12" Foreground="#AAAAAA" />
                                <Slider x:Name="SliderSmoothing" Minimum="0.1" Maximum="0.9" StepFrequency="0.05" Value="0.5" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="PanelEstabilizar" Spacing="12" Visibility="Collapsed">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Intensidad de estabilización" FontSize="12" Foreground="#AAAAAA" />
                                <Slider x:Name="SliderIntensity" Minimum="0.1" Maximum="1.0" StepFrequency="0.05" Value="0.5" />
                            </StackPanel>
                            <CheckBox x:Name="ChkAutoCrop" Content="Recorte automático" IsChecked="True" />
                        </StackPanel>

                        <!-- Línea separadora -->
                        <Border Height="1" Background="#2C2C2C" Margin="0,4" />

                        <!-- Acciones: Ejecutar y Cancelar -->
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnEjecutar" Content="Ejecutar" Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch" Click="OnEjecutarClick" />
                                <Button x:Name="BtnCancelar" Grid.Column="1" Content="Cancelar" IsEnabled="False" Click="OnCancelarClick" />
                            </Grid>

                            <ProgressBar x:Name="TaskProgressBar" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" />
                            <TextBlock x:Name="TaskProgressText" FontSize="12" Foreground="#B0B0B0" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>

                        <!-- Exportar resultado -->
                        <Button x:Name="BtnExportar" Content="Exportar resultado…" HorizontalAlignment="Stretch"
                                IsEnabled="False" Click="OnExportarClick" Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
