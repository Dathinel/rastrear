<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>Dathinel</Authors>
    <Product>Rastrear</Product>
    <!-- Versión única: la App, la Cli, el catálogo y los nombres de build\distribuir.ps1 -->
    <Version>1.0.0</Version>
    <FileVersion>$(Version).0</FileVersion>
    <Copyright>Copyright (C) 2026 Dathinel</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Dathinel/rastrear</PackageProjectUrl>
    <NoWarn>$(NoWarn);CA1711;CA1001</NoWarn>
  </PropertyGroup>

  <!-- InformationalVersion = 1.0.0+<commit>; sin git (zip de fuentes) queda 1.0.0. RASTREAR_COMMIT lo fija desde fuera. -->
  <Target Name="RastrearCommit" BeforeTargets="AddSourceRevisionToInformationalVersion;GetAssemblyVersion;GenerateAssemblyInfo" Condition="'$(SourceRevisionId)' == ''">
    <PropertyGroup Condition="'$(RASTREAR_COMMIT)' != ''"><SourceRevisionId>$(RASTREAR_COMMIT)</SourceRevisionId></PropertyGroup>
    <Exec Condition="'$(SourceRevisionId)' == ''" Command="git rev-parse --short=12 HEAD" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low" EchoOff="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="RastrearGitSalida" />
      <Output TaskParameter="ExitCode" PropertyName="RastrearGitCodigo" />
    </Exec>
    <PropertyGroup Condition="'$(SourceRevisionId)' == '' And '$(RastrearGitCodigo)' == '0'"><SourceRevisionId>$(RastrearGitSalida)</SourceRevisionId></PropertyGroup>
  </Target>
</Project>
